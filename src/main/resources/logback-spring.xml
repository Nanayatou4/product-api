<appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
    <http>
        <url>http://192.168.56.101:3100/loki/api/v1/push</url>
    </http>
    <format>
        <label>
            <pattern>app=${spring.application.name}</pattern>
        </label>
        <message>
            <pattern>%-5level [%thread] %logger{36} - %msg%n</pattern>
        </message>
    </format>
</appender>


